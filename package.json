    "test:e2e:changed": "playwright test --only-changed",
    "test:e2e:list": "playwright test --reporter=list",
    "test:e2e:debug": "playwright test --debug",
    "test:e2e:headed": "PLAYWRIGHT_SLOW_MO=1000 playwright test --headed",
    "test:e2e:ui": "playwright test --ui",
    "test:e2e:report": "playwright test && playwright show-report",
    "test:e2e:codegen": "playwright codegen http://localhost:3000",
    "storybook": "storybook dev -p 6006",
    "build-storybook": "storybook build"
  },
