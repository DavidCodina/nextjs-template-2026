  "private": true,
  "scripts": {
    "prisma-note": "Vercel prunes devDependencies. Make prisma a normal dependency for prisma migrate deploy to work.",
    "dev": "next dev",
    "build": "next build",
    "upgrade": "next upgrade",
    "start": "next start",
    "vercel-note": "Be careful not to run preview deployments against production database.",
    "vercel-build": "prisma migrate deploy && prisma generate && next build",
